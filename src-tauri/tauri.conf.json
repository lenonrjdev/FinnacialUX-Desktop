{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinnacialUX Desktop",
  "version": "1.3.0",
  "identifier": "com.ateliux.finnacialux.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000/login/",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FinnacialUX Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": {
        "default-src": "'self' customprotocol: asset:",
        "connect-src": "ipc: http://ipc.localhost",
        "font-src": "'self' data:",
        "img-src": "'self' asset: http://asset.localhost blob: data:",
        "style-src": "'self' 'unsafe-inline'"
      },
      "devCsp": {
        "default-src": "'self' http://localhost:3000 customprotocol: asset: data: blob:",
        "connect-src": "ipc: http://ipc.localhost http://localhost:3000 ws://localhost:3000",
        "font-src": "'self' http://localhost:3000 data:",
        "img-src": "'self' http://localhost:3000 asset: http://asset.localhost blob: data:",
        "script-src": "'self' 'unsafe-inline' 'unsafe-eval' http://localhost:3000",
        "style-src": "'self' 'unsafe-inline' http://localhost:3000"
      },
      "freezePrototype": false
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "publisher": "Ateliux",
    "category": "Finance",
    "shortDescription": "Controle financeiro pessoal com recuperação comprovada.",
    "longDescription": "FinnacialUX Desktop 1.3 mantém dados locais em SQLCipher e testa backups criptografados sem substituir o banco atual.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser",
        "languages": [
          "PortugueseBR",
          "English"
        ]
      },
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "allowDowngrades": false
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "",
      "endpoints": [],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
