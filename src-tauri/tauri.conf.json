{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "FinnacialUX Desktop",
  "version": "0.1.0",
  "identifier": "com.ateliux.finnacialux.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../out"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "FinnacialUX Desktop",
        "width": 1440,
        "height": 900,
        "minWidth": 1080,
        "minHeight": 700,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "decorations": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Ateliux",
    "category": "Finance",
    "shortDescription": "Controle financeiro pessoal offline.",
    "longDescription": "FinnacialUX Desktop organiza contas, cartões, compromissos, metas e relatórios em um banco SQLite armazenado no computador.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false,
        "installerIcon": "icons/icon.ico",
        "installMode": "currentUser"
      }
    }
  },
  "plugins": {
    "sql": {
      "preload": ["sqlite:finnacialux.db"]
    }
  }
}
