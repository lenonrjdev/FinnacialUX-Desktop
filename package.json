{
  "name": "finnacialux-desktop",
  "version": "1.5.0",
  "private": true,
  "description": "FinnacialUX Desktop — gestão financeira offline-first com distribuição Windows assinada, SQLCipher e Stronghold.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install chromium",
    "test:rust": "cargo test --manifest-path src-tauri/Cargo.toml --lib",
    "e2e:serve": "node scripts/validation/serve-static.mjs out 4173",
    "check:web": "npm run lint && npm run typecheck && npm run test:coverage && npm run build",
    "check:desktop": "npm run test:rust && cargo check --manifest-path src-tauri/Cargo.toml",
    "check:regression": "npm run check:web && npm run test:e2e && npm run check:desktop",
    "tauri": "tauri",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "installer": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/cli/gerar-instalador.ps1 -Local",
    "installer:offline": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/cli/gerar-instalador.ps1 -Offline",
    "validate": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/cli/validar-e-preparar-atualizacao.ps1 -SomenteValidar",
    "release:prepare": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/cli/validar-e-preparar-atualizacao.ps1",
    "release:publish": "powershell.exe -NoLogo -NoProfile -ExecutionPolicy Bypass -File scripts/cli/publicar-atualizacao.ps1",
    "check": "npm run check:regression"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0",
    "next": "16.2.12",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "@tauri-apps/plugin-log": "^2.0.0",
    "@tauri-apps/plugin-stronghold": "^2.0.0",
    "@tauri-apps/plugin-updater": "^2.0.0",
    "@tauri-apps/plugin-autostart": "^2.0.0",
    "@tauri-apps/plugin-notification": "^2.0.0",
    "@tauri-apps/plugin-window-state": "^2.0.0",
    "@tauri-apps/plugin-fs": "^2.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0",
    "@tauri-apps/cli": "^2.0.0",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.2.12",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.7.0",
    "vitest": "4.1.10",
    "@playwright/test": "1.61.1",
    "@vitest/coverage-v8": "4.1.10",
    "minimatch": "file:vendor/minimatch-v3-secure-compat"
  },
  "engines": {
    "node": ">=22.13.0",
    "npm": ">=10.9.0"
  },
  "overrides": {
    "postcss": "8.5.23",
    "sharp": "0.35.3",
    "minimatch@3.1.5": "file:vendor/minimatch-v3-secure-compat",
    "brace-expansion@1": "1.1.18",
    "brace-expansion@2": "2.1.4",
    "brace-expansion@3": "3.0.6",
    "brace-expansion@4": "5.0.9",
    "brace-expansion@5": "5.0.9"
  }
}
